# Copy this file to .env and fill in values before running the app.
# In Docker Compose, these are read from .env in this same directory.

# ---- server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where the SQLite file lives. Defaults to ./data/ampcurve.sqlite.
# DB_PATH=/app/data/ampcurve.sqlite

# Used to build links in emails (client portal invites). Set this to your
# real domain once you have one, e.g. https://ampcurve.co
APP_BASE_URL=http://localhost:3000

# ---- sessions (admin dashboard + client portal) ----------------------------
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts stored client-integration credentials (Shopify/Meta/Google Ads/
# GA4 API keys) at rest. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=

# ---- admin dashboard --------------------------------------------------------
# The dashboard has one admin account, configured here (not in the database).
ADMIN_EMAIL=admin@ampcurve.co
# Generate with: npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=

# Optional: get an email every time someone joins the waitlist.
ADMIN_NOTIFY_EMAIL=

# ---- outbound email (waitlist welcome + client invites + admin notifications) --
# Works with any SMTP provider. Leave SMTP_HOST unset to log emails to the
# console instead of sending them — useful for local development.
#
# Recommended: Resend (resend.com) — see README "Setting up Resend" for the
# full walkthrough (domain verification, API key, etc). Its SMTP settings:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend            (this is literal, not a placeholder)
#   SMTP_PASS=<your Resend API key>
#
# MAIL_FROM must use a domain you've verified in Resend. Until you've
# verified your own domain, use Resend's shared test address instead:
#   MAIL_FROM=Ampcurve <onboarding@resend.dev>
# (only deliverable to the email address on your own Resend account until
# a domain is verified — real waitlist signups won't receive it yet).
MAIL_FROM=Ampcurve <hello@ampcurve.co>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
